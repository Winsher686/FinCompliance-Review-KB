# ============================================================
# 环境变量模板（Graph RAG 电商合规审查系统）
# 用法：复制本文件为 knowledge/.env 并填入真实值。
#   Windows:   copy knowledge\.env.example knowledge\.env
#   Linux/mac: cp knowledge/.env.example knowledge/.env
# 注意：.env 已在 .gitignore 中排除，请勿把真实密钥提交到仓库。
# 全部变量均有默认值或兜底逻辑：不配置也能启动（依赖不可用时走模板兜底）。
# ============================================================

# -------------------- 大模型 --------------------
# 主模型（查询/审查）；未设置时各节点走模板兜底，仍可离线跑通
MODEL=deepseek-flash
# 视觉/多模态模型名（PDF 解析与图片理解使用）
VL_MODEL=
# 主体名识别模型（可留空，复用 MODEL）
ITEM_MODEL=

# 查询侧 LLM：langchain_deepseek.ChatDeepSeek 默认读取下面两个变量
# 走官方 API 时只需 DEEPSEEK_API_KEY；走自建网关再补 DEEPSEEK_API_BASE
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=

# 兼容 OpenAI 协议的自建网关（可选）
OPENAI_API_BASE=
OPENAI_API_KEY=

# LLM 调用的「不可靠依赖」处理：超时（秒）+ 瞬时错误最大重试次数 + 退避基数（秒）
# 仅对 timeout / connection reset / 429 / 5xx / overloaded 等瞬时错误重试，业务错误立即失败
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=0.8

# -------------------- 可观测性 --------------------
# 总开关：1 开启（默认），0 关闭后所有打点退化为空操作
OBSERVABILITY_ENABLED=1
# 内存中保留的 trace 条数上限（环形缓冲，超出淘汰最旧的）
OBSERVABILITY_MAX_TRACES=200
# 持久化方式：off（默认，纯内存）/ jsonl / mongo；失败一律降级为日志，不影响主流程
OBSERVABILITY_SINK=off
# jsonl 落盘路径（默认 knowledge/data/observability/trace.jsonl）
OBSERVABILITY_FILE=
# mongo 落库目标（缺省复用 MONGO_URL / MONGO_DB_NAME）
OBSERVABILITY_MONGO_URI=
OBSERVABILITY_MONGO_DB=

# -------------------- Milvus（向量库）--------------------
# 混合检索（BGE-M3 dense + sparse、WeightedRanker）承载库
MILVUS_URL=http://127.0.0.1:19530
EMBEDDING_DIM=1024
# 三类集合名（首次导入会自动创建，保持默认即可）
CHUNKS_COLLECTION=chunks_collection
ITEM_NAME_COLLECTION=item_name_collection
ENTITY_NAME_COLLECTION=entity_name_collection

# -------------------- Neo4j（知识图谱）--------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# -------------------- MongoDB（会话历史）--------------------
# answer_output_node 写入历史、GET /history 读取、item_name 回填均依赖；
# 未配置时历史记录功能整体不可用（服务仍可启动）
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowledge_base

# -------------------- MinIO（对象存储）--------------------
# 导入流程把解析后的 PDF / 图片放到 MinIO；查询流程按需回取
# 注意：凭证必须通过环境变量提供，代码中不再有默认口令
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET_NAME=knowledge-base
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=0

# -------------------- 服务安全 --------------------
# 设置后所有业务接口需带请求头 X-API-Key；留空则不启用鉴权（仅建议本地/演示）
API_KEY=
# CORS 白名单（逗号分隔），禁止使用 *
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://127.0.0.1:8002

# -------------------- 外部检索（MCP 网络搜索）--------------------
# 密钥必须通过环境变量提供，代码中不再硬编码
MCP_SEARCH_URL=
MCP_SEARCH_TOKEN=
MCP_DASHSCOPE_BASE_URL=

# ============================================================
# 电商合规审查流程（review_process，服务默认端口 8002）
# ============================================================

# -------------------- 文档处理（导入侧）--------------------
# 支持的文件扩展名（逗号分隔）
SUPPORTED_DOC_EXTENSIONS=.md,.html,.htm,.docx,.pdf
# 是否启用「条款级」切分（违规处罚决定书/平台规则等按条分割）
CLAUSE_SPLIT_ENABLED=1
# 条款标题正则（默认匹配 第X条/第X章 等）
CLAUSE_HEADING_PATTERN=^第[一二三四五六七八九十百零〇\d]+[条章节款项]
# 默认来源（文档未显式提供 source 时写入的兜底值）
DEFAULT_DOC_SOURCE=上传文件

# -------------------- 检索（审查侧）--------------------
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=5
RERANK_MAX_TOP_K=10
REVIEW_EMBEDDING_SEARCH_LIMIT=10
REVIEW_HYDE_SEARCH_LIMIT=5
REVIEW_RERANK_MAX_TOP_K=10
MAX_CONTEXT_CHARS=12000
REVIEW_MAX_CONTEXT_CHARS=12000

# 多路检索并发：单路超时秒数（超时该路降级为空结果，不阻塞其他两路）与线程池大小
REVIEW_SEARCH_BRANCH_TIMEOUT=20
REVIEW_SEARCH_MAX_WORKERS=3

# RRF 融合参数与各路权重（向量 / 稀疏 / 图谱）
RRF_K=60
RRF_MAX_RESULTS=10
RRF_VECTOR_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.0
RRF_KG_WEIGHT=0.7

# 重排序动态截断（分数落差阈值）
RERANK_MIN_TOP_K=1
RERANK_GAP_RATIO=0.5
RERANK_GAP_ABS=0.2

# 主体名对齐分档（BGE-M3 混合检索分数）
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.6
ITEM_NAME_MAX_OPTIONS=3
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5

# -------------------- 图谱检索 --------------------
# 主体名对齐的最低分（低于则判为未命中）
KG_ENTITY_ALIGN_MIN_SCORE=0.6
KG_MAX_SEED_CANDIDATES=3
KG_MAX_TOTAL_SEEDS=30
KG_MAX_TRIPLES_PER_SEED=50
KG_MAX_TOTAL_TRIPLES=50
KG_MAX_TOTAL_CHUNKS=50
KG_MAX_RELATIONS=50
# 两实体间路径的最大跳数（内部会钳制到 1..5）与返回路径条数上限
KG_MAX_PATH_HOPS=3
KG_MAX_PATHS=5

# -------------------- 人工复核（HITL）--------------------
# 是否启用人工复核：1 启用，0 关闭
HITL_ENABLED=1
# 触发人工复核的风险等级（逗号分隔）：高 / 中 / 低
HITL_RISK_LEVELS=高
# 无论风险高低，这些审查类型一律进入人工复核（逗号分隔）
HITL_REVIEW_TYPES=report,violation,product_compliance

# -------------------- 合规规则阈值 --------------------
# R1 违禁词/极限词宣传：命中违禁词数 ≥ 该阈值（默认 1）
COMPLIANCE_BANNED_WORD_HIT=1
# R2 资质缺失或过期：资质有效期早于「今天 + 该天数」即视为过期（默认 0）
COMPLIANCE_CERT_EXPIRE_DAYS=0
# R3 违规未整改：近 N 年内存在违规处罚但未见整改（默认 3 年）
COMPLIANCE_PENALTY_YEARS=3
# R5 类目错放与价格违规：促销折扣率 ≥ 该比例视为虚构原价嫌疑（默认 50%）
COMPLIANCE_FAKE_PRICE_RATIO=0.5
# R6 品牌授权链穿透：授权链的最小穿透深度（默认 2）
COMPLIANCE_PENETRATION_DEPTH=2

# -------------------- 嵌入 / 重排序模型 --------------------
# BGE 重排序模型路径（本机绝对路径，按实际修改）
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=1

# 项目（产品）名诊断开关
ITEM_NAME_DIAG=1
